PORT=5000
MONGODB_URI=mongodb://localhost:27017/sendriya
JWT_SECRET=super_secret_jwt_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_67890
NODE_ENV=development

# Razorpay Credentials (set to mock values or active testing keys)
RAZORPAY_KEY_ID=rzp_test_mockKeyId123
RAZORPAY_KEY_SECRET=mockKeySecret456

# Cloudinary Config (or local fallbacks)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP configuration (for receipt and status notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@sendriya.org
